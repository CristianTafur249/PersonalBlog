# Contenido desde Dropbox (opcional). Sin estas tres variables el blog usa solo data/blog.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Subcarpeta dentro de la carpeta de la app (vacío = la raíz). Dentro van entradas/ y proyectos/
DROPBOX_FOLDER=
# Segundos entre regeneraciones de las páginas con contenido (por defecto 300)
CONTENT_REVALIDATE_SECONDS=
